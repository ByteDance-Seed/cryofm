---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import BlogSection from "@/components/sections/BlogSection.astro";

// Use the same number of posts per page as the pagination page
const POSTS_PER_PAGE = 6;
// Blog homepage displays the first page content
const currentPage = 1;
---

<Layout title="Publications">
  <section class="relative z-20 container mx-auto my-12 px-7 lg:px-0">
    <PageHeader
      title="Publications"
      description="Explore our publications on AI for CryoEM. Feel free to follow the updates!"
    />
  </section>
  <section class="relative z-20 mx-auto my-12  lg:px-0">
    <div class="mt-12">
      <BlogSection
        title="All publications"
        listPage={true}
        pagination={{
          enable: true,
          currentPage: currentPage
        }}
        postsPerPage={POSTS_PER_PAGE}
      />
    </div>
  </section>
</Layout>